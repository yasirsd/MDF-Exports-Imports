# MDF Exports & Imports — public site configuration
# Copy to .env and adjust. All VITE_ vars are exposed to the client.

# WhatsApp number in international format, digits only (no +, spaces or dashes)
VITE_WHATSAPP_NUMBER=919000000000

# Primary business phone (tel: link)
VITE_CONTACT_PHONE=+919000000000

# Primary business email
VITE_CONTACT_EMAIL=exports@mdfexportsimports.com

# Canonical site URL (used for SEO / OpenGraph)
VITE_SITE_URL=https://mdfexportsimports.com

# Contact map: precise business address or "lat,lng" for an accurate map pin
VITE_MAP_QUERY=Andhra Pradesh, India
