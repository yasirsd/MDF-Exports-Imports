# MDF Exports & Imports — public site configuration
# Copy to .env and adjust. All VITE_ vars are exposed to the client.

# WhatsApp number in international format, digits only (no +, spaces or dashes)
VITE_WHATSAPP_NUMBER=919676447773

# Primary business phone (tel: link)
VITE_CONTACT_PHONE=+919676447773

# Primary business email
VITE_CONTACT_EMAIL=contact@mdfexport.com

# Canonical site URL (used for SEO / OpenGraph) — production apex with www
VITE_SITE_URL=https://www.mdfexport.com

# Contact map: Google place name/address or "lat,lng" for an accurate map pin
# Verified: "MD FRUIT MERCHANTS, Ongole" centers the Contact embed on the business
VITE_MAP_QUERY=MD FRUIT MERCHANTS, Ongole
